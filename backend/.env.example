MONGO_URI=mongodb://127.0.0.1:27017/your-db-name
DATABASE_URL=postgresql://postgres:your_password@db.your_project_ref.supabase.co:5432/postgres
DB_SSL=true
JWT_SECRET=use-a-long-random-string
PORT=5000
